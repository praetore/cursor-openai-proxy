{
  "name": "cursor-openai-proxy",
  "version": "1.0.0",
  "description": "Local OpenAI-compatible chat API for Cursor SDK, with Windows system tray",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cursor-openai-proxy": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:bg": "powershell -NoProfile -WindowStyle Hidden -Command \"Start-Process -WindowStyle Hidden node -ArgumentList 'dist/index.js' -WorkingDirectory '%CD%'\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "cursor",
    "openai",
    "chat-completions",
    "sdk",
    "tray"
  ],
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "open": "^10.2.0",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
